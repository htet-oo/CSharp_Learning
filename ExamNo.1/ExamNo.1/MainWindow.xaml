<Window x:Class="ExamNo._1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ExamNo._1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Label Content="身長" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <TextBox x:Name="tbxHeight" Grid.Column="1" TextWrapping="Wrap" Height="20"/>
        <Label Grid.Column="2" Content="cm" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Label Grid.Column="3" Content="体重" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <TextBox x:Name="tbxWeight" Grid.Column="4" TextWrapping="Wrap" Height="20"/>
        <Label Grid.Column="5" Content="kg" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Button x:Name="btnCheck" Grid.Column="6" Content="チェック" HorizontalAlignment="Center" VerticalAlignment="Center" Click="btnCheck_Click"/>
        <Label  Grid.Column="1" Grid.Row="1" Content="判定結果" HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <Label  Grid.Column="1" Grid.Row="2" Content="BMI" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Label  Grid.Column="1" Grid.Row="3" Content="適正体重" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Label  Grid.Column="1" Grid.Row="4" Content="適正体重より" HorizontalAlignment="Center" VerticalAlignment="Center"/>


        <Label x:Name="lblBmi"  Grid.Column="3" Grid.Row="2" Content="結果待ち状能" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Label x:Name="lblStdWeight"  Grid.Column="3" Grid.Row="3" Content="結果待ち状能" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Label x:Name="lblDiffWeight"  Grid.Column="3" Grid.Row="4" Content="結果待ち状能" HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <Label x:Name="lblJudge"  Grid.Column="1" Grid.Row="5" Grid.ColumnSpan="3" Content="あなたの肥満度は" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</Window>

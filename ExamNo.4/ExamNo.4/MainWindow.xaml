<Window x:Class="ExamNo._4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ExamNo._4"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Label Content="購入金額" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <TextBox x:Name="tbxBuy" Grid.Column="1" TextWrapping="Wrap" Height="20"/>
        <Label Grid.Column="2" Content="支払金額" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <TextBox x:Name="tbxPay" Grid.Column="3" TextWrapping="Wrap" Height="20"/>
        <Button x:Name="btnCal"  Grid.Column="4" Content="会計" HorizontalAlignment="Center" VerticalAlignment="Center" Click="btnCal_Click"/>

        <Label x:Name="lblChg" Grid.Column="1" Grid.Row="1"  Content="お釣り: ０円" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Label Grid.Column="2" Grid.Row="1" Grid.ColumnSpan="2"  Content="会計" HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <Label x:Name="lblTenThous" Grid.Column="3" Grid.Row="2" Content="10000円札 * " HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Label x:Name="lblFiveThous" Grid.Column="3" Grid.Row="3" Content="5000円札 * " HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Label x:Name="lblOneThous" Grid.Column="3" Grid.Row="4" Content="1000円札 * " HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Label x:Name="lblFiveHund" Grid.Column="3" Grid.Row="5" Content="500円 * " HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Label x:Name="lblOneHund" Grid.Column="3" Grid.Row="6" Content="100円 * " HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Label x:Name="lblFifty" Grid.Column="3" Grid.Row="7" Content="50円 * " HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Label x:Name="lblTen" Grid.Column="3" Grid.Row="8" Content="10円 * " HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Label x:Name="lblFive" Grid.Column="3" Grid.Row="9" Content="5円 * " HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Label x:Name="lblOne" Grid.Column="3" Grid.Row="10" Content="1円 * " HorizontalAlignment="Center" VerticalAlignment="Center"/>


    </Grid>
</Window>

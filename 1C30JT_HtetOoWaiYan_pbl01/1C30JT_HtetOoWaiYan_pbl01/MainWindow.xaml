
<Window x:Class="_1C30JT_HtetOoWaiYan_pbl01.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_1C30JT_HtetOoWaiYan_pbl01"
        mc:Ignorable="d"
        Title="Money Tracker"
        Height="550"
        Width="800"
        Background="#F5F7FB">

    <Window.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="25"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Window.Resources>

    <!-- MAIN LAYOUT -->
    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR -->
        <Border Grid.Column="0"
                Background="#EAF1FF"
                BorderBrush="#D6E3FA"
                BorderThickness="0,0,1,0">

            <StackPanel Margin="15">

                <TextBlock Text="💰 Money Tracker"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#24344D"
                           Margin="0,15,0,30"/>

                <!-- HOME BUTTON -->
                <Button x:Name="btn_home"
                        Content="🏠  ホーム"
                        Height="50"
                        Margin="0,5"
                        Padding="10"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="#2563EB"
                        Background="#D6E5FF"
                        BorderThickness="0"
                        HorizontalContentAlignment="Left"
                        Click="btn_home_Click"/>

                <!-- TRANSACTION HISTORY BUTTON -->
                <Button x:Name="btn_history"
                        Content="◷  取引履歴"
                        Height="50"
                        Margin="0,5"
                        Padding="10"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="#24344D"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalContentAlignment="Left"
                        Click="btn_history_Click"/>

            </StackPanel>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Column="1">

            <!-- HOME UI -->
            <Grid x:Name="HomePanel"
                  Visibility="Visible">

                <Grid Margin="25">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- SUMMARY CARDS -->
                    <Grid Grid.Row="0" Margin="0,0,0,20">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- BALANCE -->
                        <Border Grid.Column="0"
                                Background="#E3F6ED"
                                Style="{StaticResource CardStyle}">

                            <StackPanel>
                                <TextBlock Text="💰  残高"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="#176B43"/>

                                <TextBlock x:Name="tbl_balance"
                                           Text="¥0"
                                           FontSize="34"
                                           FontWeight="Bold"
                                           Foreground="#176B43"
                                           Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- INCOME -->
                        <Border Grid.Column="1"
                                Background="#E8F0FF"
                                Style="{StaticResource CardStyle}">

                            <StackPanel>
                                <TextBlock Text="⬆  収入"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="#2859A8"/>

                                <TextBlock x:Name="tbl_income"
                                           Text="+¥0"
                                           FontSize="34"
                                           FontWeight="Bold"
                                           Foreground="#2859A8"
                                           Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- EXPENSE -->
                        <Border Grid.Column="2"
                                Background="#FDEBEC"
                                Style="{StaticResource CardStyle}">

                            <StackPanel>
                                <TextBlock Text="⬇  支出"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="#C53030"/>

                                <TextBlock x:Name="tbl_expense"
                                           Text="-¥0"
                                           FontSize="34"
                                           FontWeight="Bold"
                                           Foreground="#C53030"
                                           Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                    </Grid>

                    <!-- INPUT AREA -->
                    <Border Grid.Row="1"
                            Background="White"
                            CornerRadius="18"
                            Padding="25"
                            Margin="5,0,5,20"
                            BorderBrush="#E5EAF3"
                            BorderThickness="1">

                        <StackPanel>

                            <TextBlock Text="収入・支出を追加"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="#24344D"
                                       Margin="0,0,0,20"/>

                            <TextBlock Text="金額を入力してください"
                                       FontSize="16"
                                       Foreground="#334155"
                                       Margin="0,0,0,8"/>

                            <!-- AMOUNT AND BUTTONS -->
                            <Grid Margin="0,0,0,20">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                </Grid.ColumnDefinitions>

                                <!-- AMOUNT INPUT -->
                                <TextBox x:Name="tbx_amountInput"
                                         Grid.Column="0"
                                         Height="55"
                                         FontSize="20"
                                         VerticalContentAlignment="Center"
                                         Padding="10"
                                         Margin="0,0,15,0"
                                         BorderBrush="#CBD5E1"
                                         BorderThickness="1"/>

                                <!-- INCOME BUTTON -->
                                <Button x:Name="btn_income"
                                        Grid.Column="1"
                                        Content="＋ 収入を追加"
                                        Background="#16A34A"
                                        Foreground="White"
                                        FontSize="16"
                                        FontWeight="Bold"
                                        Height="55"
                                        Margin="0,0,15,0"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="AddTransaction_Click"/>

                                <!-- EXPENSE BUTTON -->
                                <Button x:Name="btn_expense"
                                        Grid.Column="2"
                                        Content="－ 支出を追加"
                                        Background="#DC2626"
                                        Foreground="White"
                                        FontSize="16"
                                        FontWeight="Bold"
                                        Height="55"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="AddTransaction_Click"/>

                            </Grid>

                            <!-- DATE AND MEMO -->
                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="2*"/>
                                </Grid.ColumnDefinitions>

                                <!-- DATE -->
                                <StackPanel Grid.Column="0"
                                            Margin="0,0,15,0">

                                    <TextBlock Text="日付"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="#334155"
                                               Margin="0,0,0,8"/>

                                    <DatePicker x:Name="dp_transactionDate"
                                                Height="45"
                                                FontSize="16"/>
                                </StackPanel>

                                <!-- MEMO -->
                                <StackPanel Grid.Column="1">

                                    <TextBlock Text="メモ"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="#334155"
                                               Margin="0,0,0,8"/>

                                    <TextBox x:Name="tbx_memo"
                                             Height="45"
                                             FontSize="16"
                                             VerticalContentAlignment="Center"
                                             Padding="10"
                                             BorderBrush="#CBD5E1"
                                             BorderThickness="1"/>
                                </StackPanel>

                            </Grid>

                        </StackPanel>
                    </Border>

                </Grid>
            </Grid>

            <!-- TRANSACTION HISTORY PAGE -->
            <Frame x:Name="MainFrame"
                   Visibility="Collapsed"
                   NavigationUIVisibility="Hidden"/>

        </Grid>

    </Grid>
</Window>

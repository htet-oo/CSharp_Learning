<Page x:Class="_1C30JT_HtetOoWaiYan_pbl01.TransactionHistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F5F7FB"
      Title="Transaction History">

    <Page.Resources>

        <Style x:Key="FilterLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

    </Page.Resources>

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- FILTER SECTION -->
        <Border Grid.Row="0"
                Background="White"
                CornerRadius="18"
                Padding="22"
                Margin="5,5,5,20"
                BorderBrush="#E5EAF3"
                BorderThickness="1">

            <StackPanel>

                <TextBlock Text="取引履歴を検索"
                           FontSize="23"
                           FontWeight="Bold"
                           Foreground="#24344D"
                           Margin="0,0,0,20"/>

                <!-- DATE FILTER -->
                <Grid Margin="0,0,0,18">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="35"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="開始日"
                                   Style="{StaticResource FilterLabelStyle}"/>

                        <DatePicker x:Name="dp_fromDate"
                                    Height="42"
                                    FontSize="15"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="～"
                               FontSize="20"
                               Foreground="#64748B"
                               VerticalAlignment="Bottom"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="終了日"
                                   Style="{StaticResource FilterLabelStyle}"/>

                        <DatePicker x:Name="dp_toDate"
                                    Height="42"
                                    FontSize="15"/>
                    </StackPanel>

                </Grid>

                <!-- TYPE, MINIMUM AMOUNT AND SEARCH -->
                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>

                    <!-- TYPE -->
                    <StackPanel Grid.Column="0"
                                Margin="0,0,12,0">

                        <TextBlock Text="取引種類"
                                   Style="{StaticResource FilterLabelStyle}"/>

                        <ComboBox x:Name="cbx_typeFilter"
                                  Height="42"
                                  FontSize="15"
                                  SelectedIndex="0"
                                  Padding="8">

                            <ComboBoxItem Content="すべて"/>
                            <ComboBoxItem Content="収入"/>
                            <ComboBoxItem Content="支出"/>

                        </ComboBox>

                    </StackPanel>

                    <!-- MINIMUM AMOUNT -->
                    <StackPanel Grid.Column="1"
                                Margin="0,0,12,0">

                        <TextBlock Text="最低金額"
                                   Style="{StaticResource FilterLabelStyle}"/>

                        <TextBox x:Name="tbx_minAmount"
                                 Height="42"
                                 FontSize="15"
                                 Padding="10"
                                 VerticalContentAlignment="Center"
                                 BorderBrush="#CBD5E1"
                                 BorderThickness="1"/>

                    </StackPanel>

                    <!-- SEARCH BUTTON -->
                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Bottom">

                        <Button x:Name="btn_search"
                                Content="🔍  検索"
                                Height="42"
                                Background="#2563EB"
                                Foreground="White"
                                FontSize="15"
                                FontWeight="Bold"
                                BorderThickness="0"
                                Cursor="Hand" Click="btn_search_Click"/>

                    </StackPanel>

                </Grid>

            </StackPanel>

        </Border>

        <!-- TRANSACTION DATA SECTION -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="18"
                Padding="15"
                Margin="5,0,5,5"
                BorderBrush="#E5EAF3"
                BorderThickness="1">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="取引データ一覧"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#24344D"
                           Margin="5,5,5,15"/>

                <DataGrid x:Name="dg_transactionHistory"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          Background="White"
                          BorderThickness="0"
                          RowHeight="42"
                          FontSize="14"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E5EAF3"
                          AlternatingRowBackground="#F5F7FB"
                          RowBackground="White"
                          SelectionMode="Single"
                          SelectionUnit="FullRow">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">

                            <Setter Property="Background"
                                    Value="#EAF1FF"/>

                            <Setter Property="Foreground"
                                    Value="#24344D"/>

                            <Setter Property="FontWeight"
                                    Value="Bold"/>

                            <Setter Property="FontSize"
                                    Value="14"/>

                            <Setter Property="Height"
                                    Value="45"/>

                            <Setter Property="Padding"
                                    Value="12,0"/>

                            <Setter Property="BorderThickness"
                                    Value="0,0,0,1"/>

                            <Setter Property="BorderBrush"
                                    Value="#D6E3FA"/>

                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="取引ID"
                                            Binding="{Binding TransactionId}"
                                            Width="80"/>

                        <DataGridTextColumn Header="日付"
                                            Binding="{Binding TransactionDate, StringFormat={}{0:yyyy/MM/dd}}"
                                            Width="130"/>

                        <DataGridTextColumn Header="取引種類"
                                            Binding="{Binding Type}"
                                            Width="120"/>

                        <DataGridTextColumn Header="金額"
                                            Binding="{Binding Amount, StringFormat={}{0:N0}}"
                                            Width="140"/>

                        <DataGridTextColumn Header="メモ"
                                            Binding="{Binding Memo}"
                                            Width="*"/>

                    </DataGrid.Columns>

                </DataGrid>

            </Grid>

        </Border>

    </Grid>

</Page>

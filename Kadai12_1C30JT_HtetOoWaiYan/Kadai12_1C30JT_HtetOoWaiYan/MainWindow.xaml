<Window x:Class="Kadai12_1C30JT_HtetOoWaiYan.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Kadai12_1C30JT_HtetOoWaiYan"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="800" MinWidth="800" MinHeight="600">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="130"/>
            <RowDefinition Height="130"/>
            <RowDefinition Height="130"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>
        <Label Content="総合計"
               HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
               Width="100" Height="40"
               FontWeight="Bold" FontSize="20"/>
        <Label Content="支払金額"
               Grid.Row="1"
               HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
               Width="100" Height="40"
               FontWeight="Bold" FontSize="20"/>
        <Label x:Name="lblChange" 
               Content="おつり : "
               Grid.Row="2"
               HorizontalAlignment="Center" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
               FontWeight="Bold" FontSize="20"/>
        
        <TextBox x:Name="tbxSum" 
                 Grid.Column="1" 
                 VerticalAlignment="Center" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" 
                 Height="40"
                 Padding="0,0,5,0"
                 TextWrapping="Wrap"
                 BorderThickness="3"/>
        <TextBox x:Name="tbxPay"
                 Grid.Column="1" Grid.Row="1" 
                 VerticalAlignment="Center" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" 
                 Height="40"
                 Padding="0,0,5,0"
                 TextWrapping="Wrap"
                 BorderThickness="3"/>

        <TextBlock x:Name="TextBlockState"
                   Grid.Column="1" Grid.Row="3"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   FontSize="20"
                   FontWeight="UltraLight"/>

        <Button x:Name="btnCale"
                Grid.Column="2" 
                Content="計算" 
                Width="140" Height="40"
                HorizontalAlignment="Center" VerticalAlignment="Center" Click="btnCale_Click"/>
        <Button x:Name="btnClear"
                Grid.Column="2" Grid.Row="1" 
                Content="クリア" 
                Width="140" Height="40"
                HorizontalAlignment="Center" VerticalAlignment="Center" Click="btnClear_Click"/>

    </Grid>
</Window>

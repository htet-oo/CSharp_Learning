<Window x:Class="Renshu.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Renshu"
        mc:Ignorable="d"
        Title="本の管理" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <TextBlock HorizontalAlignment="Left" Margin="102,0,0,0" TextWrapping="Wrap" Text="書籍番号ラベル" VerticalAlignment="Center" FontWeight="Bold"/>
        <TextBox x:Name="tbxBookNo" Grid.Column="1" HorizontalAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" Width="186" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="25"/>
        <TextBlock x:Name="lblBookName" Grid.Column="1" HorizontalAlignment="Left" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Center" Text="書籍名" Margin="45,0,0,0" FontWeight="Bold"/>
        <TextBlock x:Name="lblBookPrice" Grid.Column="1" HorizontalAlignment="Left" Grid.Row="2" TextWrapping="Wrap" Text="単価" VerticalAlignment="Center" Margin="45,0,0,0" FontWeight="Bold"/>
        <TextBox x:Name="tbxBookCount" Grid.Column="1" HorizontalAlignment="Center" Grid.Row="3" TextWrapping="Wrap" VerticalAlignment="Center" Width="186" Height="25" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
        <TextBlock HorizontalAlignment="Center" Grid.Row="3" TextWrapping="Wrap" Text="冊数" VerticalAlignment="Center" FontWeight="Bold"/>
        <Button x:Name="btnCalc" Grid.Column="2" Content="計算ボタン" HorizontalAlignment="Center" Grid.Row="3" VerticalAlignment="Center" Width="70" Height="25" Click="btnCalc_Click"/>
        <TextBlock x:Name="lblSum" Grid.Column="1" HorizontalAlignment="Left" Grid.Row="4" TextWrapping="Wrap" Text="金額" VerticalAlignment="Center" Margin="45,0,0,0" FontWeight="Bold"/>
    </Grid>
</Window>

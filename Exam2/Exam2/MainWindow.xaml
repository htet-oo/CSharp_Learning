<Window x:Class="Exam2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Exam2"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Label Content="西暦" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <TextBox x:Name="tbxStartyear" Grid.Column="1" TextWrapping="Wrap" Height="20"/>
        <Label Grid.Column="2" Content="から" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Label Grid.Column="3" Content="西暦" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <TextBox x:Name="tbxEndYear" Grid.Column="4" TextWrapping="Wrap" Height="20"/>
        <Button x:Name="btnCheck"  Grid.Column="6" Content="チェック" HorizontalAlignment="Center" VerticalAlignment="Center" Click="btnCheck_Click"/>


        <Label Grid.Column="1" Grid.Row="1" Content="うるう年の回数" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="2" Grid.Row="1" x:Name="lblYearCnt" TextWrapping="Wrap" VerticalAlignment="Center"/>

        <Label Grid.Column="1" Grid.Row="2" Content="会計日数" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="2" Grid.Row="2" x:Name="lblDayCnt" TextWrapping="Wrap" VerticalAlignment="Center"/>

        <Label Grid.Column="1" Grid.Row="3" Content="偶数年の回数" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="2" Grid.Row="3" x:Name="lblEventCnt" TextWrapping="Wrap" VerticalAlignment="Center"/>

        <Label Grid.Column="1" Grid.Row="4" Content="奇数年の回数" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="2" Grid.Row="4" x:Name="lblOddCnt" TextWrapping="Wrap" VerticalAlignment="Center"/>




    </Grid>
</Window>

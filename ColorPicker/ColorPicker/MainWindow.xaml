<Window x:Class="ColorPicker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ColorPicker"
        mc:Ignorable="d"
        Title="ColorChecker
        " Height="400" Width="600">
    <Grid>
        <StackPanel>
            <Label Content="カラーチェッカー" HorizontalAlignment="Center" Margin="0,22,0,0" VerticalAlignment="Top" FontSize="36" FontWeight="Bold"/>
            <Rectangle x:Name="rctResult" Margin ="20"  Stroke="Black" Height="86" Fill="#FFC15959"/>

            <Slider x:Name="sldRed" Margin = "10" Maximum="255" ValueChanged="sldRed_ValueChanged"/>
            <Slider x:Name="sldGreen" Margin = "10"  Maximum="255" ValueChanged="sldGreen_ValueChanged"/>
            <Slider x:Name="sldBlue" Margin = "10"  Maximum="255" ValueChanged="sldBlue_ValueChanged"/>
        </StackPanel>

    </Grid>
</Window>

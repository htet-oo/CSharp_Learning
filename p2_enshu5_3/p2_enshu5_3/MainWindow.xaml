<Window x:Class="p2_enshu5_3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:p2_enshu5_3"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Grid Background="#F2F4F8">

        <Border
            Width="430"
            Padding="35"
            Background="White"
            CornerRadius="12"
            BorderBrush="#DDDDDD"
            BorderThickness="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <StackPanel>

                <!-- Title -->
                <TextBlock
                    Text="ユーザー認証"
                    FontSize="26"
                    FontWeight="Bold"
                    Foreground="#263238"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,15"/>

                <TextBlock
                    Text="idとパスワードを入力してください。"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Margin="0,0,0,8"/>
                
                <!-- ID -->
                <TextBlock
                    Text="ID"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Margin="0,0,0,8"/>

                <TextBox
                    x:Name="id_textBox"
                    Height="42"
                    FontSize="15"
                    Padding="10"
                    Margin="0,0,0,20"/>

                <!-- Password -->
                <TextBlock
                    Text="パスワード"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Margin="0,0,0,8"/>

                <PasswordBox
                    x:Name="pas_TextBox"
                    Height="42"
                    FontSize="15"
                    Padding="10"
                    Margin="0,0,0,28"/>

                <!-- Inquiry Button -->
                <Button
                    Content="連絡先照会"
                    Height="45"
                    FontSize="15"
                    FontWeight="Bold"
                    Background="#2563EB"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="Button_Click"/>

                <!-- Result Message -->
                <TextBlock
                    x:Name="ret_TextBlock"
                    Text=""
                    FontSize="14"
                    TextWrapping="Wrap"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    Margin="0,25,0,0"/>

            </StackPanel>

        </Border>

    </Grid>
</Window>

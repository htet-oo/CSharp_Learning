<Window x:Class="p2_enshu_5_5.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:p2_enshu_5_5"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Background="#F2F4F8">

        <Border Width="550"
                Padding="35"
                Background="White"
                CornerRadius="12"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>

                <!-- Description -->
                <TextBlock Text="社員データの検索ができます。"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Margin="0,0,0,20"/>

                <!-- ID Search -->
                <Grid Margin="0,0,0,15">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <RadioButton x:Name="id_RadioButton"
                                 Content="id"
                                 GroupName="SearchType"
                                 FontSize="15"
                                 VerticalAlignment="Center"
                                 />

                    <TextBox x:Name="id_TextBox"
                             Grid.Column="1"
                             Height="35"
                             FontSize="15"
                             Padding="5"/>

                </Grid>

                <!-- Name Search -->
                <Grid Margin="0,0,0,15">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <RadioButton x:Name="name_RadioButton"
                                 Content="名前"
                                 GroupName="SearchType"
                                 FontSize="15"
                                 VerticalAlignment="Center"
                                 />

                    <TextBox x:Name="name_TextBox"
                             Grid.Column="1"
                             Height="35"
                             FontSize="15"
                             Padding="5"/>

                </Grid>

                <!-- Instruction -->
                <TextBlock x:Name="message_TextBlock"
                           Text=""
                           FontSize="13"
                           Margin="0,0,0,15"/>

                <!-- Search Button -->
                <Button Content="データ照会"
                        Width="180"
                        Height="45"
                        FontSize="16"
                        FontWeight="Bold"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        HorizontalAlignment="Center" Click="Button_Click"
                        />

                <!-- Result List -->
                <ListBox x:Name="result_ListBox"
                         Height="120"
                         Margin="0,25,0,0"
                         FontSize="15"
                         Padding="10"
                         Background="#F2F4F8"
                         BorderBrush="#DDDDDD"/>

            </StackPanel>

        </Border>

    </Grid>

</Window>

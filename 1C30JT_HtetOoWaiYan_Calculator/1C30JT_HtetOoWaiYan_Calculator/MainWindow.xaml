<Window x:Class="_1C30JT_HtetOoWaiYan_Calculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_1C30JT_HtetOoWaiYan_Calculator"
        mc:Ignorable="d"
        Title="MainWindow" Height="700" Width="450" MinHeight="600" MinWidth="450" Background="AntiqueWhite">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        

        <Border Grid.ColumnSpan="4" 
                Margin="10"
                BorderBrush="Black" 
                BorderThickness="2"
                CornerRadius="8"
                Background="Wheat">
            <TextBlock x:Name="txtBlock"
                       FontSize="22"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Margin="10"
                       TextWrapping="Wrap"/>
        </Border>

        <Button x:Name="btnAllClear" Content="AllClear" FontSize="40" FontWeight="Bold" Grid.Row="1" Grid.ColumnSpan="2" Margin="10" Background="#FFB3CBCC" Click="btnAllClear_Click"/>
        <Button x:Name="btnClear" Content="Clear" FontSize="40" FontWeight="Bold" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Margin="10" Background="#FFB3CBCC" Click="btnClear_Click"/>

        <Button x:Name="btnOprPlus" Content="+" FontSize="40" FontWeight="Bold" Grid.Row="2" Margin="10" Background="#FFB3CBCC" Click="btnOpr_Click"/>
        <Button x:Name="btnOprMinus" Content="-" FontSize="40" FontWeight="Bold" Grid.Row="2" Grid.Column="1" Margin="10" Background="#FFB3CBCC" Click="btnOpr_Click"/>
        <Button x:Name="btnOprMulti" Content="×" FontSize="40" FontWeight="Bold" Grid.Row="2" Grid.Column="2" Margin="10" Background="#FFB3CBCC" Click="btnOpr_Click"/>
        <Button x:Name="btnOprdiv" Content="÷" FontSize="40" FontWeight="Bold" Grid.Row="2" Grid.Column="3" Margin="10" Background="#FFB3CBCC" Click="btnOpr_Click"/>

        <Button x:Name="btnNum7" Content="7" FontSize="40" FontWeight="Bold" Grid.Row="3" Margin="10" Background="#FFB3CBCC" Click="btnNum_Click"/>
        <Button x:Name="btnNum8" Content="8" FontSize="40" FontWeight="Bold" Grid.Row="3" Grid.Column="1" Margin="10" Background="#FFB3CBCC" Click="btnNum_Click"/>
        <Button x:Name="btnNum9" Content="9" FontSize="40" FontWeight="Bold" Grid.Row="3" Grid.Column="2" Margin="10" Background="#FFB3CBCC" Click="btnNum_Click"/>

        <Button x:Name="btnNum4" Content="4" FontSize="40" FontWeight="Bold" Grid.Row="4" Margin="10" Background="#FFB3CBCC" Click="btnNum_Click"/>
        <Button x:Name="btnNum5" Content="5" FontSize="40" FontWeight="Bold" Grid.Row="4" Grid.Column="1" Margin="10" Background="#FFB3CBCC" Click="btnNum_Click"/>
        <Button x:Name="btnNum6" Content="6" FontSize="40" FontWeight="Bold" Grid.Row="4" Grid.Column="2" Margin="10" Background="#FFB3CBCC" Click="btnNum_Click"/>

        <Button x:Name="btnNum1" Content="1" FontSize="40" FontWeight="Bold" Grid.Row="5" Margin="10" Background="#FFB3CBCC" Click="btnNum_Click"/>
        <Button x:Name="btnNum2" Content="2" FontSize="40" FontWeight="Bold" Grid.Row="5" Grid.Column="1" Margin="10" Background="#FFB3CBCC" Click="btnNum_Click"/>
        <Button x:Name="btnNum3" Content="3" FontSize="40" FontWeight="Bold" Grid.Row="5" Grid.Column="2" Margin="10" Background="#FFB3CBCC" Click="btnNum_Click"/>

        <Button x:Name="btnNum0" Content="0" FontSize="40" FontWeight="Bold" Grid.Row="6" Grid.ColumnSpan="3" Margin="10" Background="#FFB3CBCC" Click="btnNum_Click"/>

        <Button x:Name="btnEqual" Content="=" FontSize="40" FontWeight="Bold" Grid.Row="3" Grid.Column="4" Grid.RowSpan="4" Margin="10" Background="#FFB3CBCC" Click="btnEqual_Click"/>
    </Grid>
</Window>
